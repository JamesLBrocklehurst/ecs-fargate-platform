# Gatus Dockerfile

# --- Build stage ---
# Use the official Go Alpine image as the build environment.
# Alpine is chosen to keep the image small while still providing the tools needed (apk, shell).
# We name this stage "builder" so the final stage can selectively copy from it.
FROM golang:alpine AS builder

# Install CA certificates in the builder stage.
# These are needed at build time so `go install` can make HTTPS connections to download the module.
RUN apk --update add ca-certificates

# Download and install the pinned Gatus release directly from its upstream module path.
# This replaces the previous approach of copying a local source tree and running `go build`.
#   CGO_ENABLED=0  — disables C bindings so the resulting binary has no libc dependency (fully static)
#   GOOS=linux     — cross-compiles for Linux regardless of the host OS (e.g. macOS)
#   go install     — downloads, builds, and installs the binary to $GOPATH/bin
#   @v5.36.0       — pins to an exact release tag for reproducible builds
#   -ldflags="-s -w" strips the debug symbol table (-s) and DWARF debug info (-w)
#                    from the binary — safe for production, typically cuts 20-30% off binary size
RUN CGO_ENABLED=0 GOOS=linux go install -ldflags="-s -w" github.com/TwiN/gatus/v5@v5.36.0

# --- Final stage ---
# distroless/static:nonroot has no shell or package manager (minimal attack surface),
# includes CA certificates, and runs as a non-root user (uid 65532) by default —
# giving us the security benefits of scratch with non-root support built in.
FROM gcr.io/distroless/static:nonroot

WORKDIR /gatus

# Copy only the compiled Gatus binary from the builder stage — nothing else from the build environment.
# The official golang:alpine image sets GOPATH=/go, so `go install` places the binary at /go/bin/gatus.
COPY --from=builder /go/bin/gatus .

# Copy the CA certificates from the builder so Gatus can make HTTPS requests at runtime
# (distroless/static:nonroot includes its own certs, but this keeps things explicit and consistent)
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Copy the monitoring config file from the repo's config/ directory into the image.
# This bakes the config in at build time so the container is self-contained.
# For ECS deployments, this can be overridden by mounting a volume or using SSM/S3 at runtime.
COPY config/config.yaml ./config/config.yaml

# Tell Gatus where to find the config file at runtime.
# This path must match where we copied config.yaml above.
ENV GATUS_CONFIG_PATH="/gatus/config/config.yaml"

# Log level can be overridden at runtime via ECS task definition environment variables.
ENV GATUS_LOG_LEVEL="INFO"

# Port Gatus listens on — can be overridden at runtime.
ENV PORT="8080"

# Documents which port the container listens on (informational only — does not publish the port).
EXPOSE ${PORT}

# Set the binary as the fixed entrypoint. Using ENTRYPOINT rather than CMD prevents
# the binary from being accidentally replaced when passing arguments to docker run.
ENTRYPOINT ["/gatus/gatus"]
