# Multi-stage build: compile Gatus in a full Go image, then run it in a
# minimal, non-root image with just the binary and its config.

# --- Build stage ---
FROM golang:alpine AS builder

# CA certs are needed here so `go install` can fetch the module over HTTPS.
RUN apk --update add ca-certificates

# Install a pinned Gatus release straight from its module path (no local source needed).
# CGO_ENABLED=0 + GOOS=linux produce a fully static Linux binary; -ldflags="-s -w" strips
# debug info to shrink it.
RUN CGO_ENABLED=0 GOOS=linux go install -ldflags="-s -w" github.com/TwiN/gatus/v5@v5.36.0

# --- Final stage ---
# distroless/static:nonroot: no shell, no package manager, runs as a non-root user by
# default — smallest attack surface for a production image.
FROM gcr.io/distroless/static:nonroot

WORKDIR /gatus

# Pull only the built binary and CA certs from the builder — nothing else comes along.
COPY --from=builder /go/bin/gatus .
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Bake the monitoring config into the image so the container is self-contained.
COPY config/config.yaml ./config/config.yaml
ENV GATUS_CONFIG_PATH="/gatus/config/config.yaml"

# Sensible defaults — both can be overridden at runtime via the ECS task definition.
ENV GATUS_LOG_LEVEL="INFO"
ENV PORT="80"
EXPOSE ${PORT}

# ENTRYPOINT (not CMD) so the binary can't accidentally be overridden by `docker run` args.
ENTRYPOINT ["/gatus/gatus"]
